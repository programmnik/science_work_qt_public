   <property name="styleSheet">
    <string notr="true">    QMenuBar {
        background-color: rgb(71, 69, 153);
        color: rgb(218, 216, 227);
        border: none;
        border-bottom: 1px solid rgba(222, 221, 218, 0.3);
        padding: 2px 6px;
        spacing: 0px;
        font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
        font-size: 14px;
        font-weight: 600;
    }
    
    QMenuBar::item {
        background-color: transparent;
        color: rgb(218, 216, 227);
        padding: 3px 6px;
        border-radius: 8px;
        margin: 2px;
    }
    
    QMenuBar::item:selected {
        background-color: rgba(222, 221, 218, 0.15);
        color: white;
        border-radius: 8px;
    }
    
    QMenuBar::item:pressed {
        background-color: rgba(222, 221, 218, 0.25);
        border-radius: 8px;
    }

    QMenu {
        background-color: rgb(55, 53, 133);
        color: rgb(218, 216, 227);
        border: 2px solid rgba(222, 221, 218, 0.3);
        border-radius: 12px;
        padding: 4px 0px;
        font-family: 'Segoe UI', sans-serif;
        font-size: 13px;
		 font-weight: 500;
    }
    
    QMenu::item {
        background-color: transparent;
        color: rgb(218, 216, 227);
        padding: 4px 8px 4px 8px;
        margin: 2px 8px;
        border-radius: 6px;
    }
    
    QMenu::item:selected {
        background-color: rgba(222, 221, 218, 0.15);
        color: white;
    }
    
    QMenu::item:pressed {
        background-color: rgba(222, 221, 218, 0.25);
    }
    
    QMenu::separator {
        height: 2px;
        background-color: rgba(222, 221, 218, 0.2);
        margin: 3px 6px;
    }
    
    /* Иконки в меню */
    QMenu::icon {
        margin-right: 12px;
    }
    
    /* Стрелка для подменю */
    QMenu::right-arrow {
        image: url(:/icons/arrow-right.png);
        width: 12px;
        height: 12px;
        margin-right: 8px;
    }</string>
